# =============================================================
# Sessions Marketplace — Environment Configuration
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example belongs in the repo.
# =============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=sessions_marketplace
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Django ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_real_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── GitHub OAuth ─────────────────────────────────────────────
# Create a GitHub OAuth App at:
#   https://github.com/settings/developers
# Set Authorization callback URL to:
#   http://localhost/api/auth/github/callback/
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost/api
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# ── Creator Demo Emails ─────────────────────────────────────
# Comma-separated list of GitHub emails that are auto-promoted
# to Creator role on first login. For demo/evaluation purposes.
# Example: creator@example.com,admin@example.com
CREATOR_EMAILS=
