{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/config/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(api|admin|static)/(.*)",
      "dest": "backend/config/wsgi.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/vite.svg",
      "dest": "frontend/vite.svg"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
